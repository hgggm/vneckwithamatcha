bagConnectButton.MouseButton1Click:Connect(function()
    if not selectedPlayer then statusLabel.Text = "Select a player first!" return end
    local victimChar = selectedPlayer.Character
    if not victimChar then return end
    local victimRoot = victimChar:FindFirstChild("HumanoidRootPart")
    if not victimRoot then return end

    local originalCF = RootPart.CFrame
    local ignored = workspace:FindFirstChild("Ignored")
    if not ignored then return end
    local shop = ignored:FindFirstChild("Shop")
    if not shop then return end

    local bagShop
    for _, v in pairs(shop:GetChildren()) do
        if string.find(v.Name, "BrownBag") then bagShop = v break end
    end
    if not bagShop then statusLabel.Text = "No BrownBag found" return end

    local click = bagShop:FindFirstChildWhichIsA("ClickDetector", true)
    local part = bagShop:FindFirstChildWhichIsA("BasePart", true)
    if not click or not part then return end

    RootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)
    task.wait(0.25)
    fireclickdetector(click)
    task.wait(0.3)

    local tool
    for i = 1, 60 do
        tool = LocalPlayer.Backpack:FindFirstChild("[BrownBag]")
        if tool then break end
        task.wait(0.1)
    end

    if not tool then
        statusLabel.Text = "No BrownBag acquired, returning..."
        RootPart.CFrame = originalCF
        return
    end

    Character.Humanoid:EquipTool(tool)
    task.wait(0.2)

    targetRoot = victimRoot
    connected = true
    toggleButton.Text = "DISCONNECT"
    toggleButton.BackgroundColor3 = Color3.fromRGB(175, 38, 38)
    statusLabel.Text = "Following & Bagging " .. selectedPlayer.Name

    spawn(function()
        while connected do
            local currentTool = Character:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChild("[BrownBag]")
            if currentTool then
                pcall(function() currentTool:Activate() end)
            else
                connected = false
                targetRoot = nil
                statusLabel.Text = "Tool lost — returning..."
                toggleButton.Text = "CONNECT"
                toggleButton.BackgroundColor3 = Color3.fromRGB(28, 155, 80)
                RootPart.CFrame = originalCF
                break
            end
            task.wait(0.15)
        end
    end)
end)

