    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then statusLabel.Text = "No HumanoidRootPart found" return end
    RootPart.CFrame = root.CFrame * CFrame.new(0, 0, 2)
    statusLabel.Text = "Teleported to " .. selectedPlayer.Name
end)

local viewing = false
viewButton.MouseButton1Click:Connect(function()
    if viewing then
        viewing = false
        if viewConnection then viewConnection:Disconnect() viewConnection = nil end
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = Character:FindFirstChildOfClass("Humanoid")
        viewButton.Text = "VIEW PLAYER"
        viewButton.BackgroundColor3 = Color3.fromRGB(60, 120, 180)
        statusLabel.Text = selectedPlayer and ("Selected: " .. selectedPlayer.Name) or "No player selected"
    else
        if not selectedPlayer then statusLabel.Text = "Select a player first!" return end
        local char = selectedPlayer.Character
        if not char then statusLabel.Text = "Player has no character" return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid then statusLabel.Text = "No Humanoid found" return end

        viewing = true
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = humanoid
        viewButton.Text = "STOP VIEWING"
        viewButton.BackgroundColor3 = Color3.fromRGB(180, 100, 20)
        statusLabel.Text = "Viewing: " .. selectedPlayer.Name

        viewConnection = RunService.Heartbeat:Connect(function()
            if not viewing then return end
            local c = selectedPlayer.Character
            if c then
                local h = c:FindFirstChildOfClass("Humanoid")
                if h and Camera.CameraSubject ~= h then
                    Camera.CameraSubject = h
                end
            end
        end)
    end
end)

resetButton.MouseButton1Click:Connect(function()
    connected = false
