-- ─────────────────────────────────────────────
-- HEARTBEAT FOLLOW WITH ROTATION
-- ─────────────────────────────────────────────
RunService.Heartbeat:Connect(function()
    if not connected or not targetRoot then return end
    if not targetRoot.Parent then
        connected = false
        statusLabel.Text = "Target lost"
        toggleButton.Text = "CONNECT"
        toggleButton.BackgroundColor3 = Color3.fromRGB(28, 155, 80)
        return
    end

    local baseCF = targetRoot.CFrame * CFrame.new(offsetX, offsetY, offsetZ)
    local rotation = CFrame.fromEulerAnglesXYZ(math.rad(rotPitch), math.rad(rotYaw), math.rad(rotRoll))
    local finalCF = baseCF * rotation

    RootPart.CFrame = finalCF
    RootPart.AssemblyLinearVelocity = Vector3.zero
    RootPart.AssemblyAngularVelocity = Vector3.zero
    sethiddenproperty(RootPart, "PhysicsRepRootPart", targetRoot)
    sethiddenproperty(RootPart, "CFrame", finalCF)
end)
