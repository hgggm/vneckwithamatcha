local function hasForceField(char)
    return char and char:FindFirstChildOfClass("ForceField") ~= nil
end

local function runSelfAbuseCycle()
    if not abuseSpawnEnabled then return end
    local myChar = LocalPlayer.Character
    if not myChar then return end

    if not hasForceField(myChar) then
        statusLabel.Text = "No ForceField detected → Force resetting now..."
        local hum = myChar:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = 0 else LocalPlayer:LoadCharacter() end
        return
    end

    statusLabel.Text = "Waiting for your ForceField to disappear..."
    while abuseSpawnEnabled and hasForceField(myChar) do task.wait(0.2) end
    if not abuseSpawnEnabled then return end

    statusLabel.Text = string.format("ForceField gone → waiting %ds then reset...", abuseSpawnDelay)
    task.wait(abuseSpawnDelay)
    if not abuseSpawnEnabled then return end

    statusLabel.Text = "Force resetting character..."
    local hum = myChar:FindFirstChildOfClass("Humanoid")
    if hum then hum.Health = 0 else LocalPlayer:LoadCharacter() end
end

local abuseSpawnConnection = nil
local function startAbuseSpawnListener()
    if abuseSpawnConnection then abuseSpawnConnection:Disconnect() end
    abuseSpawnConnection = LocalPlayer.CharacterAdded:Connect(function()
        if abuseSpawnEnabled then
            task.wait(0.3)
            spawn(runSelfAbuseCycle)
        end
    end)
end

